+    def _selection_snapshot_before_refresh(self) -> list[int]:
+        """刷新列表前冻结用户当前选择，防止新实例被旧勾选集覆盖。
+
+        勾选框每次点击都会同步文本框，因此两者一致时直接使用勾选结果；
+        两者不一致说明用户手动输入了新增实例（常见于从 11 开升到 12 开），
+        此时文本框是更新的一方，必须优先。只有两者都为空才回退配置。
+        """
+        checked = [int(i) for i in self._checked_indices()]
+        typed = [int(i) for i in self._parse_vm_text()]
+        if typed and typed != checked:
+            return typed
+        if checked:
+            return checked
+        if typed:
+            return typed
+        out: list[int] = []
+        for value in self.cfg.get("last_selected_vms") or []:
+            try:
+                idx = int(value)
+            except Exception:
+                continue
+            if idx not in out:
+                out.append(idx)
+        return out
+
+    def _apply_vm_selection(self, indices: list[int], *, persist: bool = True) -> None:
+        """在 GUI 线程原子更新文本、勾选框和 last_selected_vms。"""
+        wanted = list(dict.fromkeys(int(i) for i in indices))
+        self.cfg["last_selected_vms"] = list(wanted)
+        self.var_vms.set(",".join(str(i) for i in wanted))
+        self.refresh_vms(prefer_checked=wanted)
+        if persist:
+            save_config(self._collect_cfg())
+        self._log(
+            f"模拟器选择已同步: count={len(wanted)} VM={wanted} "
+            f"workers={int(self.var_workers.get() or 1)}"
+        )
+
