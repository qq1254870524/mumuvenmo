# runtime / secrets
__pycache__/
*.py[cod]
*.log
*.log.*
*.png
*.jpg
*.jpeg
*.flag

# local secrets and runtime outputs
accounts/input/*
!accounts/input/accounts.example.txt
!accounts/input/.gitkeep
accounts/samples/*
!accounts/samples/README.txt
!accounts/samples/.gitkeep
proxies/*
!proxies/cocks5.txt.example
!proxies/.gitkeep
export/**/*
!export/**/.gitkeep
logs/**/*
!logs/**/.gitkeep
data/setup_flags/*
!data/setup_flags/.gitkeep
data/nekobox_profiles/*
!data/nekobox_profiles/.gitkeep
data/state/*
!data/state/.gitkeep
screenshots/**/*
!screenshots/**/.gitkeep

# large APK blocked (GitHub soft limit 100MB)
assets/apk/venmo_bundle/base.apk
assets/apk/venmo_base_only_BROKEN.apk

# local machine config may be customized; keep example
config.json

# OS
.DS_Store
Thumbs.db
Desktop.ini

# backups / local junk
*.bak
*.tmp
*.swp
.codex_tmp/
